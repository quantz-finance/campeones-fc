# Campeones FC. Copia este archivo a .env.local si vas a usar Supabase o PostHog.
# Las variables EXPO_PUBLIC_* se incrustan en el bundle al arrancar o al exportar.

# Déjalas vacías para el modo demostración: datos de ejemplo en el navegador,
# sin cuenta real. Si pones una, tienes que poner las dos.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Opcional. Si EXPO_PUBLIC_POSTHOG_KEY está vacía, la analítica no hace nada.
# No envíes correos ni nombres en los eventos.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cavos (inicio de sesión y wallet de Stellar). Sin APP_ID la entrada muestra «Cavos no configurado».
EXPO_PUBLIC_CAVOS_APP_ID=
EXPO_PUBLIC_CAVOS_RP_ID=campeones-fc.vercel.app
EXPO_PUBLIC_CAVOS_ENVIRONMENT=production
EXPO_PUBLIC_STELLAR_NETWORK=testnet

# Solo servidor (funciones de /api en Vercel). Nunca con prefijo EXPO_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CAVOS_JWKS_URL=https://cavos.xyz/.well-known/jwks.json
CAVOS_JWT_ISSUERS=https://cavos.app/firebase,https://accounts.google.com,https://appleid.apple.com
CAVOS_JWT_AUDIENCE=
CAVOS_GOOGLE_AUDIENCE=
CAVOS_APPLE_AUDIENCE=
CAVOS_EXTRA_ISSUER=
STELLAR_NETWORK=testnet
PLATFORM_PUBLIC=
PLATFORM_SECRET=
CRON_SECRET=
ANCHOR_ATTEST_WAIT_HOURS=24

# --- Apuestas por partido (Trustless Work, SOLO testnet). Apagado si STAKES_ENABLED != 1. Ver docs/escrow.md ---
STAKES_ENABLED=
EXPO_PUBLIC_STAKES_ENABLED=
TRUSTLESS_WORK_API_KEY=            # propia, de https://dapp.trustlesswork.com (Settings > API Keys > Testnet)
TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com
STAKE_RESOLVER_SECRET=             # cuenta distinta de PLATFORM (dispute resolver). Fondear con friendbot.
STAKE_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STAKE_MAX_UNITS=20                 # tope por jugador (default de la UI: 10)
STAKE_FUND_WINDOW_MIN=30           # sin los dos depósitos: devolución
STAKE_RESULT_WINDOW_HOURS=24       # sin resultado confirmado: devolución
STAKE_FAUCET_UNITS=10              # >0: la tesorería (PLATFORM) regala ese test USDC a cada jugador sin saldo
FEEBUMP_MAX_INNER_FEE=1000000000   # 100 XLM testnet: TW arma fund_escrow con ~7.7 XLM de fee máximo (el sobrante de recursos se reembolsa)
