{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "store",
      "channel": "preview",
      "env": {
        "CFC_IOS_ASSOCIATED_DOMAINS": "1"
      },
      "environment": "preview"
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "CFC_IOS_ASSOCIATED_DOMAINS": "1"
      },
      "environment": "production",
      "ios": {
        "autoIncrement": true
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6834224443",
        "appleTeamId": "66MB4G5UG4"
      }
    }
  }
}
