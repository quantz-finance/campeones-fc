{
  "expo": {
    "name": "Campeones FC",
    "slug": "campeones-fc",
    "scheme": "campeones-fc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "description": "Lleva el marcador de tus partidos con amigos: series, grupos, torneos y trofeos.",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.campeonesfc",
      "associatedDomains": [
        "applinks:partido.campeonesfc.app",
        "webcredentials:partido.campeonesfc.app"
      ],
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.campeonesfc",
      "adaptiveIcon": {
        "backgroundColor": "#37003C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "partido.campeonesfc.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "lang": "es",
      "name": "Campeones FC",
      "shortName": "Campeones",
      "description": "Lleva el marcador de tus partidos con amigos: series, grupos, torneos y trofeos.",
      "themeColor": "#37003C",
      "backgroundColor": "#37003C",
      "display": "standalone",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#37003C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Campeones FC usa tus fotos para la foto de perfil, de un grupo o de un torneo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-web-browser"
    ],
    "owner": "rolandoarguello",
    "extra": {
      "eas": {
        "projectId": "8ce19e53-b9bc-4af2-ac6d-b34ff00cc5fd"
      }
    }
  }
}
