{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "functions": {
    "api/auth.ts": { "maxDuration": 20 },
    "api/anchor.ts": { "maxDuration": 60 }
  },
  "crons": [{ "path": "/api/anchor", "schedule": "*/10 * * * *" }]
}
